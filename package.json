{
  "name": "live-with-poll-monorepo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/participant",
    "apps/host"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev:participant": "npm run dev -w live-with-poll-participant",
    "dev:host": "npm run dev -w live-with-poll-host",
    "build:participant": "npm run build -w live-with-poll-participant",
    "build:host": "npm run build -w live-with-poll-host",
    "build:all": "npm run build:participant && npm run build:host"
  }
}
